# Google Apps Script deployed Web App URL (must end in /exec).
# Set this in your local .env.local. The Next.js server reads it; it is not exposed to browser code.
GOOGLE_APPS_SCRIPT_URL=https://script.google.com/macros/s/PASTE_YOUR_DEPLOYMENT_ID/exec

# Public canonical site URL (update when your domain is connected).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
